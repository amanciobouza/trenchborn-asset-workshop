				pose(side.."UpperArm",jumpPose.Arm+(lead and -32 or 32)*asymmetry,0,0)
				pose(side.."Forearm",jumpPose.Elbow+(lead and 0 or 14)*asymmetry,0,0)
				pose(side.."Hand",-jumpPose.Pulse*8,0,0)
			end
