			local leadSign=jump.Lead=="Left" and -1 or 1
			pose("Torso",jumpPose.Pitch,leadSign*3*asymmetry,leadSign*4*asymmetry)
			pose("Head",jumpPose.Head,0,0)
			pose("Jaw",0,0,0)
