					forward=u*u*(3-2*u)
				end
				-- Positive shoulder pitch carries the hanging arm forward.
				-- Extend smoothly toward the forward endpoint, flex again on return.
				local extension=forward*forward*(3-2*forward)
				local armSwing=(2*forward-1)*fade
