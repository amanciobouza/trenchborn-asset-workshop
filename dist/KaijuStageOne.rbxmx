				local angle=i*2.39996+t*2
				local radius=(1-progress)*2.2*scale
				mote.Position=mouthCF:PointToWorldSpace(Vector3.new(math.cos(angle)*radius,math.sin(angle)*radius,-(1-progress)*3*scale))
